{
  "name": "cosign-bank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "init": "bash scripts/init-tidecloak.sh",
    "seed": "node scripts/reset-demo-data.mjs",
    "deploy": "node scripts/deploy-vercel.mjs",
    "fix:vercel": "node scripts/deploy-vercel.mjs",
    "deploy:check": "node scripts/check-deploy-config.mjs",
    "verify:auth": "node scripts/verify-public-auth.mjs",
    "diagnose": "node scripts/diagnose-vercel.mjs",
    "check:supabase": "node scripts/check-supabase-config.mjs",
    "reset": "node scripts/reset-demo-data.mjs",
    "reset:faces": "node scripts/reset-face-profiles.mjs",
    "test:unauth": "node scripts/check-unauthenticated.mjs",
    "test:policy": "node --test scripts/check-withdrawal-policy.mjs",
    "test:client": "node --test scripts/check-client-fetch.mjs",
    "test:app-policy": "node --experimental-strip-types --test scripts/check-app-approval-policy.mjs",
    "test:liveness": "node --experimental-strip-types --test scripts/check-liveness-policy.mjs",
    "test:face": "node --experimental-strip-types --test scripts/check-face-identity.mjs",
    "test:supabase": "node --experimental-strip-types --test scripts/check-supabase-identity.mjs scripts/check-supabase-env.mjs",
    "test:contract": "bash scripts/check-forseti-docker.sh",
    "test:all": "npm run typecheck && npm run test:policy && npm run test:app-policy && npm run test:liveness && npm run test:face && npm run test:supabase && npm run test:client && npm run test:unauth",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tidecloak/nextjs": "0.14.17",
    "@vladmandic/human": "^3.3.6",
    "jose": "^6.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
