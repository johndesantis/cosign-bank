# ---------------------------------------------------------------------------
# TideCloak master-admin credentials — LOCAL DEVELOPMENT ONLY
#
# Copy this file to `.env` and set a value. `.env` is gitignored; this example
# is not, so never put a real secret HERE.
#
#   cp .env.example .env
#   $EDITOR .env          # set KC_BOOTSTRAP_ADMIN_PASSWORD
#
# The init script reads these from the environment (loading `.env` if present)
# and REFUSES TO RUN if the password is unset — it no longer carries a default,
# because a default is a hardcoded credential with extra steps.
#
# This is a bootstrap/operator credential: it must never appear in client code,
# in `tidecloak.json`, in an image, or in the repo (AP-41). It is also the
# credential that mints the 60-second master-admin token, so for any browser
# flow it belongs in the SERVER environment only — never shipped to the client.
#
# For anything beyond local Docker, inject it from your secret manager instead
# of a file, and use a strong value: this account can administer the realm.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=


# === Tide licence email + Terms & Conditions ===============================
#
# Setting up a realm licenses it to an email address under Tide's Terms & Conditions:
#   https://tide.org/legal
#
# Both are answered by the person who owns the deployment. The bootstrap/init script asks at a
# terminal and REFUSES TO RUN without them otherwise. An AI agent must ask the user and may not
# fill these in itself (AP-90).
#
#   TIDE_LICENSE_EMAIL    a real address you control; placeholders are rejected
#   TIDE_TERMS_ACCEPTED   set to `yes` only by the person who read and agreed to the terms
#
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# ---------------------------------------------------------------------------
# Adapter JSON — REQUIRED for hosted deployments (Vercel, CI, containers)
#
# data/tidecloak.json is gitignored, so a build checkout has no adapter file.
# The app reads this variable instead; locally it falls back to the file.
# Server-side only, and must be one line:
#   jq -c . data/tidecloak.json
#
# It is public configuration (public client + realm public keys), not a secret.
# Run `npm run deploy:check` to print ready-to-paste upload commands.
# CLIENT_ADAPTER={"realm":"cosign-bank","auth-server-url":"https://...","ssl-required":"external","resource":"cosign-bank-client","public-client":true,"confidential-port":0,"jwk":{"keys":[]}}
#
# Aliases: TIDECLOAK_ADAPTER (same JSON), CLIENT_ADAPTER_B64 (base64 of it —
# use when a dashboard mangles multi-line pastes: base64 -w0 data/tidecloak.json)
# CLIENT_ADAPTER_B64=

# Tide custom signing policy status
#
# The withdrawal contract in security/forseti/ must be reviewed and deployed by
# the Tide team on a test network. The local app can record two approvals from
# verified Tide role holders, but it deliberately has no signing bypass: until
# deployment exists, Forseti signing and bank execution stay unavailable.

# === Simulated TideCloak identity ==========================================
#
# When NO adapter is configured, the app authenticates against a simulator so the
# full flow can be built and reviewed: three owners, real role checks on every
# protected route, signed bearer tokens. It is a faithful *shape* of TideCloak and
# explicitly not Tide cryptography: no DPoP, no ORK threshold, no QEA.
#
# Default: enabled (1) when no adapter resolves. Set to 0 to disable the simulator
# and show the preview/configuration page instead.
DEMO_AUTH=1
#
# Secret used to sign simulated tokens. The default constant is PUBLIC on purpose —
# it is a demo issuer, not a security boundary. Set a value only to keep tokens
# valid across instances; never treat it as protection.
# DEMO_AUTH_SECRET=
#
# Resource/client name used in the simulated `azp`/audience claims.
# TIDECLOAK_RESOURCE=cosign-bank-client

# === Supabase email/password accounts =====================================
#
# Enables email + password sign-in and registration for any email provider.
# Takes precedence over the simulator below. Set from your Supabase project:
#   Project Settings -> API -> Project URL and `anon` / `public` key.
#
# IMPORTANT: use the ANON (public) key. Never put the service-role key in a
# NEXT_PUBLIC_* variable — it bypasses row-level security and ships to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Passwords are NOT stored by this application. Supabase Auth (GoTrue) keeps a
# bcrypt hash in auth.users; sign-up/sign-in happen between the browser and
# Supabase over HTTPS, and our API only ever receives the resulting access token.
#
# Optional: restrict the joint-owner role to specific accounts. Leave unset for the
# demo-open policy where every authenticated account is a joint owner.
# JOINT_OWNER_EMAILS=admin.a@example.com,founder.b@example.com
#
# Validate before deploying:  npm run check:supabase
# Profile table (optional):    supabase/migrations/0001_profiles.sql
